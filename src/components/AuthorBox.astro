---
import Avatar from './Avatar.astro';
import { authorUrl } from '../lib/site';
interface Props { id: string; name: string; role: string; bio: string; initials: string; color: string }
const a = Astro.props;
---
<aside class="author-box" aria-label="About the author">
  <Avatar initials={a.initials} color={a.color} size={40} />
  <div>
    <p class="name"><a href={authorUrl(a.id)} rel="author">{a.name}</a> <span class="meta">· {a.role}</span></p>
    <p class="bio">{a.bio} <a href={authorUrl(a.id)} class="more">More stories by {a.name}</a></p>
  </div>
</aside>
<style>
  .author-box { display: flex; gap: 14px; align-items: flex-start; max-width: var(--measure); margin-top: 32px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .name { margin: 0 0 4px; font: 700 15px/1.3 var(--sans); }
  .name a { text-decoration: none; }
  .bio { margin: 0; font: italic 400 15px/1.5 var(--serif); color: var(--ink-2); }
  .more { font: 600 13px/1 var(--sans); white-space: nowrap; }
</style>
