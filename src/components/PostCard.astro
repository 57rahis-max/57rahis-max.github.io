---
import { getEntry } from 'astro:content';
import type { Post } from '../lib/posts';
import { lastTouched } from '../lib/posts';
import { postUrl, fmtWhen, categoryUrl, thumb, imageSize, isInfoCard } from '../lib/site';
/**
 * One story in a list. Variants follow newspaper conventions:
 *  lead    – big headline, dek, image below the headline (the front's top story)
 *  normal  – image on top, headline, dek (section grids)
 *  side    – small thumbnail at right, headline (rails and dense lists)
 *  text    – headline and time only (headline columns)
 */
interface Props {
  post: Post;
  size?: 'lead' | 'normal' | 'side' | 'text';
  /** Heading level: h2 for the stories that lead a page, h3 inside a titled section. */
  as?: 'h2' | 'h3';
  /** Hide the section label inside a section that already names it. */
  kicker?: boolean;
  /** Show "By Name". Off on an author's own page, where every story is theirs. */
  byline?: boolean;
  eager?: boolean;
}
const { post, size = 'normal', as: H = 'h3', kicker = true, byline = true, eager = false } = Astro.props;
const d = post.data;
const live = d.live === 'live';
const authorName = byline ? (await getEntry(d.author))?.data.name : undefined;
const when = live ? lastTouched(post) : d.date;
const img = thumb(d.image?.src);
const dim = imageSize(img) ?? { width: 800, height: 450 };
// A side thumbnail is too small to read an information card, so those stories list without one.
const showImg = size !== 'text' && !!d.image && !(size === 'side' && isInfoCard(d.image.src));
const fit = isInfoCard(d.image?.src) ? ' fit' : ''; // an information card is shown whole, never cropped
---
<article class={`card ${size}${showImg ? '' : ' noimg'}`}>
  {showImg && size !== 'lead' && (
    <a href={postUrl(post.id)} class="img-link" tabindex="-1" aria-hidden="true">
      <img class={`card-img${fit}`} src={img} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width={dim.width} height={dim.height} />
    </a>
  )}
  <div class="card-body">
    {(kicker || live) && (
      <p class="kicker">
        {live ? <span class="live-pill">Live</span> : <a href={categoryUrl(d.category)} class="cat">{d.category}</a>}
      </p>
    )}
    <H class="card-title"><a href={postUrl(post.id)}>{d.title}</a></H>
    {(size === 'lead' || size === 'normal') && <p class="card-dek">{d.description}</p>}
    {showImg && size === 'lead' && (
      <a href={postUrl(post.id)} class="img-link" tabindex="-1" aria-hidden="true">
        <img class={`card-img${fit}`} src={img} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width={dim.width} height={dim.height} />
      </a>
    )}
    {(authorName || live) && (
      <p class="meta byline">
        {authorName && <span>By {authorName}</span>}
        {authorName && live && ' · '}
        {live && <time datetime={when.toISOString()}>Updated {fmtWhen(when)}</time>}
      </p>
    )}
  </div>
</article>
<style>
  .card { display: grid; gap: 10px; align-content: start; }
  .card-body { display: grid; gap: 6px; }
  .card .cat { text-decoration: none; }
  .img-link { display: block; }
  .card-title { margin: 0; }
  .card-dek { margin: 0; }
  .meta { margin: 0; }
  .byline { font-size: 12.5px; font-weight: 600; letter-spacing: .01em; }

  .lead .card-title { font-size: clamp(1.7rem, 2.6vw, 2.3rem); line-height: 1.1; font-weight: 700; letter-spacing: -.015em; }
  .lead .card-dek { font: 400 17px/1.5 var(--serif); color: var(--ink-2); }
  .lead .img-link { margin-top: 8px; }

  .normal .card-title { font-size: 1.2rem; line-height: 1.25; }

  .side { grid-template-columns: minmax(0, 1fr) 96px; gap: 14px; }
  .side .img-link { order: 2; }
  .side.noimg { grid-template-columns: 1fr; }
  .side .card-img { aspect-ratio: 1; }
  .side .card-title { font-size: 1.05rem; line-height: 1.3; }

  .text .card-title { font-size: 1.05rem; line-height: 1.3; }
</style>
