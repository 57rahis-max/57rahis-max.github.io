---
import type { Post } from '../lib/posts';
import { lastTouched } from '../lib/posts';
import { postUrl, fmtWhen, categoryUrl, thumb, imageSize } from '../lib/site';
interface Props { post: Post; size?: 'lead' | 'normal' | 'side' | 'compact'; authorName?: string }
const { post, size = 'normal', authorName } = Astro.props;
const d = post.data;
const live = d.live === 'live';
const when = live ? lastTouched(post) : d.date;
const img = thumb(d.image?.src);
const dim = imageSize(img) ?? { width: 800, height: 450 };
const showImg = size !== 'compact' && !!d.image;
---
<article class={`card ${size}${showImg ? '' : ' noimg'}`}>
  {showImg && (
    <a href={postUrl(post.id)} class="img-link" tabindex="-1" aria-hidden="true">
      <img class="card-img" src={img} alt="" loading="lazy" decoding="async" width={dim.width} height={dim.height} />
    </a>
  )}
  <div class="card-body">
    <p class="kicker">
      {live ? <span class="live-pill">Live</span> : <a href={categoryUrl(d.category)} class="cat">{d.category}</a>}
    </p>
    <h3 class="card-title"><a href={postUrl(post.id)}>{d.title}</a></h3>
    {(size === 'lead' || size === 'normal') && <p class="card-dek">{d.description}</p>}
    <p class="meta">
      <time datetime={when.toISOString()}>{live ? `Updated ${fmtWhen(when)}` : fmtWhen(when)}</time>{authorName && <> · {authorName}</>}
    </p>
  </div>
</article>
<style>
  .card { display: grid; gap: 12px; align-content: start; }
  .card .cat { text-decoration: none; }
  .img-link { display: block; overflow: hidden; border-radius: var(--radius); }
  .card-img { transition: transform .35s ease; }
  .card:hover .card-img { transform: scale(1.03); }
  .lead .card-title { font-size: clamp(1.7rem, 3.3vw, 2.5rem); line-height: 1.1; font-weight: 800; }
  .lead .card-dek { font-size: 17.5px; line-height: 1.5; }
  .side { grid-template-columns: minmax(0, 1fr) 112px; gap: 14px; border-top: 1px solid var(--rule); padding-top: 14px; }
  .side .img-link { order: 2; }
  .side.noimg { grid-template-columns: 1fr; }
  .side .card-img { aspect-ratio: 4 / 3; }
  .side .card-title { font-size: 1.02rem; margin-top: .25em; }
  .compact { border-top: 1px solid var(--rule); padding-top: 12px; gap: 0; }
  .compact .card-title { font-size: 1.02rem; }
  @media (prefers-reduced-motion: reduce) { .card-img { transition: none; } .card:hover .card-img { transform: none; } }
</style>
