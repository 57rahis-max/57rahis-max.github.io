---
interface Props { cite: string; source?: string }
const { cite, source } = Astro.props;
---
<figure class="pullquote">
  <blockquote><slot /></blockquote>
  <figcaption>— {cite}{source && <span>, according to {source}</span>}</figcaption>
</figure>
<style>
  .pullquote { margin: 2em 0; padding: 4px 0 4px 22px; border-left: 4px solid var(--accent); }
  .pullquote blockquote { margin: 0; border: 0; padding: 0; font: 600 italic 1.5rem/1.35 var(--serif); color: var(--ink); }
  .pullquote figcaption { margin-top: .6em; font: 600 14px/1.4 var(--sans); color: var(--muted); }
</style>
