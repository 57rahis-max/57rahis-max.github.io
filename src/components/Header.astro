---
import { NAV, SITE } from '../lib/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const Mark = home ? 'h1' : 'div';
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-in">
      <span class="today" data-today>{new Date().toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <div class="top-actions">
        <a href="/about/" class="toplink">About</a>
        <a href="/editorial-standards/" class="toplink">Standards</a>
        <button class="icon-btn" type="button" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="wrap masthead">
    <p class="edition meta" aria-hidden="true">US crime and courts</p>
    <Mark class="wordmark-wrap">
      <a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>
        <span class="w1">MAX</span><span class="w2">CRIME</span>
      </a>
      {home && <span class="sr-only">: crime and court news, sourced and attributed</span>}
    </Mark>
    <p class="tagline">{SITE.tagline}</p>
  </div>

  <nav class="mainnav" aria-label="Main">
    <div class="wrap nav-in">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-list" data-menu>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>Menu</span>
      </button>
      <ul id="nav-list">
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined} class={n.label === 'Live' ? 'nav-live' : ''}>{n.label}</a></li>
        ))}
      </ul>
      <a href="/search/" class="nav-search" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Zm5.3-2.2L21 21"/></svg>
      </a>
    </div>
  </nav>
</header>

<script>
  // The date is the reader's today in the newsroom's time zone, not the day the site was built.
  const t = document.querySelector('[data-today]');
  if (t) t.textContent = new Date().toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
  const reflect = () => toggle?.setAttribute('aria-pressed', String(isDark()));
  reflect();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', reflect);
  toggle?.addEventListener('click', () => {
    root.dataset.theme = isDark() ? 'light' : 'dark';
    try { localStorage.setItem('mc-theme', root.dataset.theme); } catch {}
    reflect();
  });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const list = document.getElementById('nav-list');
  const setMenu = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    list?.classList.toggle('open', open);
  };
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setMenu(false); btn.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (btn?.getAttribute('aria-expanded') === 'true' && !btn.contains(e.target as Node) && !list?.contains(e.target as Node)) setMenu(false);
  });
</script>

<style>
  .topbar { background: #111317; color: #d9d7d2; }
  .topbar-in { display: flex; justify-content: space-between; align-items: center; height: 38px; gap: 12px; }
  .today { font: 500 12.5px/1 var(--sans); letter-spacing: .02em; }
  .top-actions { display: flex; align-items: center; gap: 6px; }
  .toplink { font: 600 12.5px/1 var(--sans); color: #d9d7d2; text-decoration: none; padding: 6px 8px; }
  .toplink:hover { color: #fff; }
  .icon-btn { background: none; border: 0; color: #d9d7d2; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; cursor: pointer; }
  .icon-btn:hover { background: #2a2e36; color: #fff; }
  .icon-btn[aria-pressed='true'] { background: #2a2e36; }

  .masthead { text-align: center; padding: 22px 20px 14px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; }
  .edition { margin: 0; text-align: left; text-transform: uppercase; letter-spacing: .14em; font-weight: 700; font-size: 11.5px; }
  .wordmark-wrap { margin: 0; font-size: inherit; }
  .wordmark { display: inline-flex; align-items: center; text-decoration: none; font: 900 clamp(40px, 6.4vw, 64px)/1 var(--serif); letter-spacing: .02em; color: var(--ink); }
  .wordmark .w2 { color: var(--accent); margin-left: .2em; }
  .tagline { margin: 0; text-align: right; font: 500 11.5px/1.3 var(--sans); color: var(--muted); letter-spacing: .03em; }

  /* Double rule under the masthead, as on a printed front page; the nav sits on it */
  .mainnav { border-top: 3px double var(--ink); border-bottom: 1px solid var(--ink); position: sticky; top: 0; background: var(--paper); z-index: 30; }
  .nav-in { display: flex; align-items: center; justify-content: center; position: relative; }
  .mainnav ul { list-style: none; display: flex; justify-content: center; gap: 2px; margin: 0; padding: 0; }
  .mainnav a { display: block; padding: 13px 15px; font: 700 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .mainnav ul a[aria-current='page'] { color: var(--accent); box-shadow: inset 0 -3px 0 var(--accent); }
  .nav-live::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--live); margin-right: 7px; vertical-align: 1px; }
  .nav-search { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); padding: 8px !important; color: var(--ink); }
  .menu-btn { display: none; align-items: center; gap: 8px; background: none; border: 0; color: var(--ink); font: 800 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; padding: 12px 0; cursor: pointer; }

  @media (max-width: 720px) {
    .tagline, .edition { display: none; }
    .masthead { padding: 16px 20px 10px; grid-template-columns: 1fr; }
    .toplink { display: none; }
    .nav-in { justify-content: space-between; }
    .nav-search { position: static; transform: none; }
    /* Without JavaScript the list stays visible (stacked). JS adds .js and collapses it behind the Menu button. */
    .mainnav ul { flex-direction: column; padding: 0 0 8px; }
    :global(html.js) .mainnav ul { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 3px solid var(--ink); padding: 6px 20px 12px; box-shadow: 0 12px 24px rgb(0 0 0 / .12); }
    :global(html.js) .mainnav ul.open { display: flex; }
    .menu-btn { display: none; }
    :global(html.js) .menu-btn { display: inline-flex; }
    .mainnav ul a { padding: 14px 0; border-bottom: 1px solid var(--rule); }
    .mainnav ul a[aria-current='page'] { box-shadow: none; }
  }
</style>
