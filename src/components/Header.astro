---
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname;
const today = new Date().toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-in">
      <span class="meta">{today}</span>
      <button class="theme-toggle" type="button" aria-label="Switch light or dark theme" data-theme-toggle>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
      </button>
    </div>
  </div>
  <div class="wrap masthead">
    <a href="/" class="wordmark" aria-label={`${SITE.name} home`}>
      <span class="bar" aria-hidden="true"></span>MAX<span>CRIME</span>
    </a>
    <p class="tagline">{SITE.tagline}</p>
  </div>
  <nav class="mainnav" aria-label="Main">
    <div class="wrap">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined} class={n.label === 'Live' ? 'nav-live' : ''}>{n.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>
<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('mc-theme', root.dataset.theme); } catch {}
  });
</script>
<style>
  .topbar { border-bottom: 1px solid var(--rule); }
  .topbar-in { display: flex; justify-content: space-between; align-items: center; height: 36px; }
  .theme-toggle { background: none; border: 1px solid var(--rule); color: var(--ink); border-radius: 50%; width: 28px; height: 28px; display: grid; place-items: center; cursor: pointer; }
  .masthead { text-align: center; padding: 22px 20px 14px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 900 clamp(34px, 6vw, 56px)/1 var(--serif); letter-spacing: .04em; color: var(--ink); }
  .wordmark span { color: var(--accent); margin-left: .18em; }
  .wordmark .bar { width: 10px; height: .82em; background: var(--accent); margin: 0; }
  .tagline { margin: 8px 0 0; font: 500 13px/1.3 var(--sans); color: var(--muted); letter-spacing: .02em; }
  .mainnav { border-top: 1px solid var(--rule); border-bottom: 3px solid var(--ink); position: sticky; top: 0; background: var(--paper); z-index: 20; }
  .mainnav ul { list-style: none; display: flex; justify-content: center; gap: 4px; margin: 0; padding: 0; overflow-x: auto; scrollbar-width: none; }
  .mainnav a { display: block; padding: 12px 14px; font: 700 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .mainnav a[aria-current='page'] { color: var(--accent); }
  .nav-live::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--live); margin-right: 6px; vertical-align: 1px; }
  @media (max-width: 640px) { .mainnav ul { justify-content: flex-start; } .tagline { display: none; } }
</style>
