---
import Base from './Base.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap page">
    <h1 class="headline">{title}</h1>
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { padding-top: 30px; }
  .page h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 18px; }
</style>
