---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts, lastTouched, type Post } from '../lib/posts';
import { website, publisher } from '../lib/schema';
import { SITE, postUrl, categoryUrl, fmtWhen } from '../lib/site';

const posts = await allPosts();
const names = Object.fromEntries((await getCollection('authors')).map((a) => [a.id, a.data.name]));
const name = (p: Post) => names[p.data.author.id];
const live = posts.filter((p) => p.data.live === 'live');

// A real photograph leads the page. Information cards (timelines, summaries)
// are good inside a story but read as a slide on a front page.
const isPhoto = (p: Post) => !!p.data.image && !/(?:^|[-_./])(?:card|timeline|summary)(?=[-_.]|\.\w+$)/i.test(p.data.image.src);

// Each story appears once on the front page. Sections take from the pool in order.
const used = new Set<string>();
const take = (list: Post[], n: number) => {
  const out = list.filter((p) => !used.has(p.id)).slice(0, n);
  out.forEach((p) => used.add(p.id));
  return out;
};
const [lead] = take(posts.filter(isPhoto), 1);
const second = take(posts, 1);                      // under the lead, text only
const centre = take(posts.filter(isPhoto), 2);      // two photo stories in the middle column
const latest = posts.slice(0, 8);                   // the right rail lists the newest eight, whatever else shows them
const crime = take(posts.filter((p) => p.data.category === 'Crime News'), 4);
const courtPool = posts.filter((p) => p.data.category === 'Courts' && !used.has(p.id));
const courtLead = courtPool.find(isPhoto) ?? courtPool[0];
const courts = courtLead ? [courtLead, ...courtPool.filter((p) => p.id !== courtLead.id).slice(0, 4)] : [];
courts.forEach((p) => used.add(p.id));
const more = take(posts, 12);
---
<Base title={SITE.name} home schema={[website, { '@context': 'https://schema.org', ...publisher }]}>
  <div class="wrap">

    {live.length > 0 && (
      <div class="live-strip" role="region" aria-label="Live coverage">
        <span class="live-pill">Live</span>
        <ul>{live.map((p) => <li><a href={postUrl(p.id)}>{p.data.title}</a></li>)}</ul>
      </div>
    )}

    {lead && (
      <section class="front" aria-labelledby="h-front">
        <h2 id="h-front" class="sr-only">Top stories</h2>
        <div class="col col-lead">
          <PostCard post={lead} size="lead" authorName={name(lead)} eager />
          {second.map((p) => <div class="under"><PostCard post={p} size="text" authorName={name(p)} /></div>)}
        </div>

        <div class="col col-centre">
          {centre.map((p, i) => <div class={i ? 'stack' : ''}><PostCard post={p} size="normal" authorName={name(p)} eager={i === 0} /></div>)}
        </div>

        <aside class="col col-rail" aria-labelledby="h-latest">
          <h2 id="h-latest" class="rail-head">Latest</h2>
          <ol class="hairlines rail-list">
            {latest.map((p) => (
              <li>
                <a href={postUrl(p.id)}>
                  <time class="rail-time" datetime={lastTouched(p).toISOString()}>{fmtWhen(lastTouched(p))}</time>
                  <span class="rail-title">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="promise" aria-label="How Max Crime reports">
            <p class="kicker">How we report</p>
            <p>A fact appears here only if two independent outlets report it, or it comes from a police, prosecutor or court record. Charges are allegations until a court rules.</p>
            <a href="/editorial-standards/">Read our standards</a>
          </div>
        </aside>
      </section>
    )}

    {crime.length > 0 && (
      <section aria-labelledby="h-crime" class="block">
        <div class="rule-head"><h2 id="h-crime">Crime news</h2><a class="all" href={categoryUrl('Crime News')}>All crime news</a></div>
        <div class="four">{crime.map((p) => <PostCard post={p} size="normal" authorName={name(p)} />)}</div>
      </section>
    )}

    {courts.length > 0 && (
      <section aria-labelledby="h-courts" class="block">
        <div class="rule-head"><h2 id="h-courts">Courts &amp; trials</h2><a class="all" href={categoryUrl('Courts')}>All court stories</a></div>
        <div class="courts">
          <div class="courts-lead"><PostCard post={courts[0]} size="lead" authorName={name(courts[0])} /></div>
          <ul class="hairlines courts-list">{courts.slice(1).map((p) => <li><PostCard post={p} size="side" authorName={name(p)} /></li>)}</ul>
        </div>
      </section>
    )}

    {more.length > 0 && (
      <section aria-labelledby="h-more" class="block more-grid">
        <div class="rule-head"><h2 id="h-more">More stories</h2></div>
        <ul class="hairlines three-col">{more.map((p) => <li><PostCard post={p} size="side" authorName={name(p)} /></li>)}</ul>
      </section>
    )}
  </div>
</Base>

<style>
  .live-strip { display: flex; gap: 14px; align-items: center; margin: 18px 0 0; padding: 12px 16px; border: 1px solid var(--rule); border-left: 4px solid var(--live); }
  .live-strip ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font: 700 15px/1.35 var(--serif); }
  .live-strip a { text-decoration: none; }

  /* Front: three newspaper columns separated by hairlines */
  .front { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr); margin-top: 26px; }
  .col { padding: 0 24px; }
  .col:first-child { padding-left: 0; }
  .col:last-child { padding-right: 0; }
  .col + .col { border-left: 1px solid var(--rule); }
  .under { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .stack { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--rule); }

  .rail-head { margin: 0 0 10px; font: 800 13px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; padding-bottom: 10px; border-bottom: 1px solid var(--ink); }
  .rail-list li { padding: 11px 0; }
  .rail-list a { display: grid; gap: 3px; text-decoration: none; }
  .rail-time { font: 700 11.5px/1 var(--sans); letter-spacing: .04em; color: var(--accent); text-transform: uppercase; }
  .rail-title { font: 700 15.5px/1.3 var(--serif); }
  .rail-list a:hover .rail-title { text-decoration: underline; text-decoration-thickness: 1px; }

  .promise { margin-top: 22px; padding: 16px 18px; border: 1px solid var(--rule); border-top: 3px solid var(--ink); background: var(--card); }
  .promise p { margin: 0 0 8px; font: 400 14.5px/1.5 var(--serif); color: var(--ink-2); }
  .promise .kicker { margin-bottom: 8px; }
  .promise a { font: 700 13px/1 var(--sans); }

  .block { margin-top: 10px; }
  .four { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 28px; }
  .four > :global(.card) { padding: 0 0 20px; }
  .four > :global(.card + .card) { border-left: 1px solid var(--rule); padding-left: 14px; margin-left: -14px; }

  .courts { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0 32px; }
  .courts-list { border-left: 1px solid var(--rule); padding-left: 16px; margin-left: -16px; }
  .courts-list li { padding: 14px 0; }
  .courts-list li:first-child { padding-top: 0; }

  .three-col { columns: 3; column-gap: 40px; column-rule: 1px solid var(--rule); }
  .three-col > li { break-inside: avoid; padding: 14px 0; }
  .three-col > li:first-child { padding-top: 0; }
  .three-col > li:first-child { border-top: 0; }

  @media (max-width: 1100px) {
    .front { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
    .col-rail { grid-column: 1 / -1; border-left: 0; padding: 22px 0 0; margin-top: 26px; border-top: 1px solid var(--ink); }
    .rail-list { columns: 2; column-gap: 40px; }
    .rail-list li { break-inside: avoid; }
    .four { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 28px; }
    .four > :global(.card + .card) { border-left: 0; padding-left: 0; margin-left: 0; }
    .four > :global(.card:nth-child(even)) { border-left: 1px solid var(--rule); padding-left: 14px; margin-left: -14px; }
    .three-col { columns: 2; }
  }
  @media (max-width: 760px) {
    .front { grid-template-columns: 1fr; }
    .col { padding: 0; border-left: 0 !important; }
    .col-centre { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--rule); }
    .rail-list { columns: 1; }
    .four { grid-template-columns: 1fr; gap: 0; }
    .four > :global(.card) { padding: 16px 0; border-top: 1px solid var(--rule); }
    .four > :global(.card:nth-child(even)) { border-left: 0; padding-left: 0; margin-left: 0; }
    .courts { grid-template-columns: 1fr; }
    .courts-list { border-left: 0; padding-left: 0; margin: 20px 0 0; }
    .three-col { columns: 1; }
  }
</style>
