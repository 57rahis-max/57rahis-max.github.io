---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, type Post } from '../../lib/posts';
import { slugify } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await allPosts();
  const cats = new Map<string, string>();
  for (const p of posts) cats.set(slugify(p.data.category), p.data.category);
  if (!cats.has('courts')) cats.set('courts', 'Courts');
  return [...cats].map(([slug, name]) => ({
    params: { cat: slug },
    props: { name, posts: posts.filter((p) => slugify(p.data.category) === slug || (slug === 'courts' && p.data.tags.includes('courts'))) },
  }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
const names = Object.fromEntries((await getCollection('authors')).map((a) => [a.id, a.data.name]));
---
<Base title={name} description={`${name} stories from Max Crime.`} schema={[breadcrumbs([{ name: 'Home', url: '/' }, { name, url: Astro.url.pathname }])]}>
  <div class="wrap">
    <div class="rule-head"><h1 class="h">{name}</h1></div>
    {posts.length === 0 && <p class="meta">No stories yet.</p>}
    <div class="grid">{posts.map((p) => <PostCard post={p} authorName={names[p.data.author.id]} />)}</div>
  </div>
</Base>
<style>
  .h { font: 800 14px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px 26px; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
