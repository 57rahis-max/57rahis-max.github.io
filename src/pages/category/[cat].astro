---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, type Post } from '../../lib/posts';
import { slugify, isInfoCard } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await allPosts();
  const cats = new Map<string, string>();
  for (const p of posts) cats.set(slugify(p.data.category), p.data.category);
  if (!cats.has('courts')) cats.set('courts', 'Courts');
  return [...cats].map(([slug, name]) => ({
    params: { cat: slug },
    props: { name, posts: posts.filter((p) => slugify(p.data.category) === slug || (slug === 'courts' && p.data.tags.includes('courts'))) },
  }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
// A section front: the newest story leads with the next three beside it, then the rest four across.
const lead = posts.find((p) => p.data.image && !isInfoCard(p.data.image.src)) ?? posts[0];
const rest = posts.filter((p) => p !== lead);
const beside = rest.slice(0, 3);
const grid = rest.slice(3);
---
<Base title={name} description={`${name} from Max Crime: ${posts.length} ${posts.length === 1 ? 'story' : 'stories'} on US crime and courts, each sourced to at least two outlets or an official record.`} schema={[breadcrumbs([{ name: 'Home', url: '/' }, { name, url: Astro.url.pathname }])]}>
  <div class="wrap">
    <header class="section-head">
      <h1>{name}</h1>
      <p class="meta">{posts.length} {posts.length === 1 ? 'story' : 'stories'}</p>
    </header>
    {!lead && <p class="meta">No stories yet.</p>}
    {lead && (
      <div class="top">
        <div class="top-lead"><PostCard post={lead} size="lead" as="h2" kicker={false} eager /></div>
        {beside.length > 0 && <ul class="hairlines beside">{beside.map((p) => <li><PostCard post={p} size="side" as="h2" kicker={false} /></li>)}</ul>}
      </div>
    )}
    {grid.length > 0 && (
      <section aria-labelledby="h-more">
        <div class="rule-head"><h2 id="h-more">More {name.toLowerCase()}</h2></div>
        <div class="four">{grid.map((p) => <PostCard post={p} size="normal" kicker={false} />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
  .section-head { display: flex; align-items: baseline; gap: 16px; padding: 30px 0 14px; border-bottom: 1px solid var(--ink); margin-bottom: 24px; }
  .section-head h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.05; }
  .section-head .meta { margin: 0; }
  .top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0 32px; margin-bottom: 10px; }
  .beside { border-left: 1px solid var(--rule); padding-left: 16px; margin-left: -16px; }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr; } .beside { border-left: 0; padding-left: 0; margin: 20px 0 0; } }
</style>
