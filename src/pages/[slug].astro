---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorBox from '../components/AuthorBox.astro';
import PostCard from '../components/PostCard.astro';
import LiveUpdates from '../components/LiveUpdates.astro';
import YouTube from '../components/YouTube.astro';
import Tweet from '../components/Tweet.astro';
import PullQuote from '../components/PullQuote.astro';
import { allPosts, related, lastTouched, sortedUpdates, type Post } from '../lib/posts';
import { articleSchema, crumbsFor } from '../lib/schema';
import { sanitizeCredit } from '../lib/html';
import { fmtDateTime, fmtWhen, categoryUrl, authorUrl, postUrl, readingMinutes, srcsetFor, imageSize, SITE } from '../lib/site';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const d = post.data;
const author = (await getEntry(d.author))!;
const a = { id: author.id, ...author.data };
const { Content } = await render(post);
const posts = await allPosts();
const more = related(post, posts, 4);
const latest = posts.filter((p) => p.id !== post.id).slice(0, 6);
const touched = lastTouched(post);
// An "updated" time is shown, and sent to search engines, only for a real later
// edit or a live update, not the save WordPress made moments after publishing.
const wasUpdated = touched.getTime() - d.date.getTime() > 60 * 60 * 1000;
const modified = wasUpdated ? touched : d.date;
const body = post.body ?? '';
const bodyText = body.replace(/<[^>]+>/g, ' ');
const hasX = d.embeds.some((e) => e.type === 'x');
const heroSet = srcsetFor(d.image?.src);
const heroDim = imageSize(d.image?.src) ?? { width: 1600, height: 900 };
const shareUrl = encodeURIComponent(new URL(postUrl(post.id), SITE.url).href);
const shareText = encodeURIComponent(d.title);
---
<Base
  title={d.title}
  seoTitle={d.seoTitle}
  description={d.description}
  image={d.image?.src}
  imageAlt={d.image?.alt}
  type="article"
  published={d.date}
  modified={wasUpdated ? modified : undefined}
  schema={[articleSchema(post, a, bodyText, modified), crumbsFor(post)]}
>
  <div class="wrap article">
  <div class="art-grid">
  <article class="art-main" data-pagefind-body>
    <nav class="crumbs meta" aria-label="Breadcrumb" data-pagefind-ignore>
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={categoryUrl(d.category)}>{d.category}</a></li>
        <li aria-current="page">{d.seoTitle ?? d.title}</li>
      </ol>
    </nav>

    <header class="art-head">
      <p class="kicker">
        {d.live === 'live' ? <span class="live-pill">Live</span> : d.live === 'ended' ? <span class="live-pill ended">Live coverage ended</span> : <a href={categoryUrl(d.category)}>{d.category}</a>}
      </p>
      <h1 class="headline">{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <div>
          <p class="by">By <a href={authorUrl(a.id)} rel="author">{a.name}</a><span class="meta">, {a.role}</span></p>
          <p class="meta">
            Published <time datetime={d.date.toISOString()}>{fmtDateTime(d.date)}</time>
            {wasUpdated && <> · Updated <time datetime={modified.toISOString()}>{fmtDateTime(modified)}</time></>}
            {' '}· {readingMinutes(body)} min read
          </p>
        </div>
      </div>
    </header>

    {d.image && (
      <figure class="hero">
        <img src={d.image.src} srcset={heroSet} sizes="(max-width: 760px) 100vw, 1000px" alt={d.image.alt} width={heroDim.width} height={heroDim.height} loading="eager" fetchpriority="high" data-pagefind-meta="image[src]" />
        {(d.image.caption || d.image.credit) && (
          <figcaption class="figure-caption">{d.image.caption}{d.image.credit && <> <span set:html={sanitizeCredit(d.image.credit)} /></>}</figcaption>
        )}
      </figure>
    )}

        {d.updates.length > 0 && <LiveUpdates updates={sortedUpdates(post)} status={d.live} stamp={touched.toISOString()} />}
        <div class="prose">
          <Content />
        </div>

        {d.embeds.length > 0 && (
          <section class="embeds" aria-label="Video, posts and quotes">
            {d.embeds.map((e) =>
              e.type === 'youtube' ? <YouTube id={e.id} title={e.title} caption={e.caption} />
              : e.type === 'x' ? <Tweet url={e.url} author={e.author} text={e.text} date={e.date} />
              : <PullQuote cite={e.cite} source={e.source}>{e.text}</PullQuote>
            )}
          </section>
        )}
        {hasX && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}

        {d.sources.length > 0 && (
          <section class="sources" aria-label="Sources">
            <h2>Sources</h2>
            <ul>
              {d.sources.map((s) => (
                <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.title ? `${s.name}: ${s.title} (opens in a new tab)` : `${s.name} (opens in a new tab)`}>{s.name}{s.title && <>: {s.title}</>}</a>{s.date && <span class="meta"> ({s.date})</span>}</li>
              ))}
            </ul>
          </section>
        )}

        <div class="share" role="group" aria-label="Share this story" data-pagefind-ignore>
          <span class="meta">Share</span>
          <a href={`https://x.com/intent/post?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
          <a href={`mailto:?subject=${shareText}&body=${shareUrl}`}>Email</a>
        </div>

        <div data-pagefind-ignore><AuthorBox {...a} /></div>
  </article>

  <aside class="art-side" aria-labelledby="h-latest">
    <h2 id="h-latest" class="label">Latest</h2>
    <ol class="hairlines rail-list">
      {latest.map((p) => (
        <li><a href={postUrl(p.id)}><time class="rail-time" datetime={lastTouched(p).toISOString()}>{fmtWhen(lastTouched(p))}</time><span class="rail-title">{p.data.title}</span></a></li>
      ))}
    </ol>
  </aside>
  </div>

  <section class="more-grid" aria-labelledby="h-more">
    <div class="rule-head"><h2 id="h-more">More from Max Crime</h2></div>
    <div class="four">{more.map((p) => <PostCard post={p} size="normal" />)}</div>
  </section>
  </div>
</Base>

<style>
  .article { padding-top: 20px; }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs li + li::before { content: '›'; margin-right: 6px; color: var(--muted); }
  .crumbs li[aria-current] { color: var(--muted); max-width: 48ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crumbs a { text-decoration: none; }
  .art-head { max-width: 900px; margin: 14px 0 22px; }
  .headline { font-size: clamp(2rem, 4.4vw, 3.1rem); line-height: 1.08; margin: 10px 0 12px; font-weight: 800; }
  .dek { font: 400 1.25rem/1.45 var(--serif); color: var(--muted); margin: 0 0 18px; }
  .byline { display: flex; gap: 12px; align-items: center; padding-top: 14px; border-top: 1px solid var(--rule); }
  .by .meta { font-weight: 500; }
  .by { margin: 0 0 2px; font: 700 15px/1.2 var(--sans); }
  .by a { text-decoration: none; }
  .byline .meta { margin: 0; }
  .hero { margin: 0 0 28px; max-width: 900px; }
  .hero img { width: 100%; height: auto; }
  .art-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; }
  .embeds { max-width: var(--measure); display: grid; gap: 28px; margin-top: 28px; }
  .sources { max-width: var(--measure); margin-top: 36px; padding-top: 18px; border-top: 2px solid var(--ink); }
  .sources h2 { font: 800 13px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; margin: 0 0 12px; }
  .sources ul { padding-left: 1.1em; margin: 0; font-size: 15px; }
  .sources li { margin: 6px 0; }
  .share { display: flex; gap: 14px; align-items: center; margin: 28px 0 0; font: 700 14px/1 var(--sans); }
  .share a { text-decoration: none; padding: 8px 12px; border: 1px solid var(--ink); }
  .art-side { position: sticky; top: 64px; align-self: start; border-left: 1px solid var(--rule); padding-left: 28px; margin-left: -28px; }
  .art-side .label { border-top: 0; padding-top: 0; }
  .more-grid { margin-top: 24px; }
  @media (max-width: 960px) { .art-grid { grid-template-columns: 1fr; gap: 20px; } .art-side { position: static; border-left: 0; padding-left: 0; margin-left: 0; } .art-side .label { border-top: 1px solid var(--ink); padding-top: 10px; } }
</style>
