---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts } from '../lib/posts';
const posts = (await allPosts()).filter((p) => p.data.updates.length > 0);
const now = posts.filter((p) => p.data.live === 'live');
const past = posts.filter((p) => p.data.live !== 'live');
---
<Base title="Live coverage" description="Developing crime and court stories, updated as they happen.">
  <div class="wrap">
    <header class="section-head"><h1>Live coverage</h1><p class="meta">Developing stories, updated as they happen</p></header>
    <h2 class="label">Live now</h2>
    {now.length === 0 ? <p class="meta">No live coverage right now.</p> : <div class="four">{now.map((p) => <PostCard post={p} as="h3" />)}</div>}
    {past.length > 0 && (<>
      <div class="rule-head"><h2>Past live coverage</h2></div>
      <div class="four">{past.map((p) => <PostCard post={p} as="h3" />)}</div>
    </>)}
  </div>
</Base>
<style>
  .section-head { display: flex; align-items: baseline; gap: 16px; padding: 30px 0 14px; border-bottom: 1px solid var(--ink); margin-bottom: 24px; }
  .section-head h1 { margin: 0; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.05; }
  .section-head .meta { margin: 0; }
</style>
